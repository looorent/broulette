{
  "name": "biteroulette-web",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "version": "0.0.10",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "wrangler dev --local --log-level log",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "npm run build && wrangler deploy",
    "db:gen": "dotenv -e .dev.vars -- drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:reset": "npm run clean:d1 && npm run db:migrate:local",
    "db:studio:local": "DB_PATH=$(find .wrangler/state/v3/d1 -name '*.sqlite' | head -n 1) && export DB_PATH && echo \"Connecting to $DB_PATH\" && npx drizzle-kit studio --config drizzle.local.config.ts",
    "db:studio:prod": "dotenv -e .dev.vars -- drizzle-kit studio --config drizzle.prod.config.ts",
    "pwa:assets": "pwa-assets-generator",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typegen && tsc -b",
    "typegen": "wrangler types && react-router typegen",
    "clean": "rm -rf .wrangler dist build node_modules/.cache",
    "clean:d1": "rm -rf .wrangler/state/v3/d1",
    "postinstall": "npm run typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.15.1",
    "@react-router/fs-routes": "8.5.1",
    "@use-gesture/react": "10.3.1",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.3",
    "lucide-react": "1.71.0",
    "opening_hours": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@eslint/js": "9.39.4",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.72.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-checker": "1.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^5.1.0",
    "wrangler": "4.159.0"
  },
  "exports": {
    "@persistence": "./src/features/db.server/index.ts",
    "@features": "./src/features",
    "@routes": "./src/routes",
    "@components": "./src/components",
    "@config/server": "./src/config.server.ts",
    "@config": "./src/config.ts"
  },
  "overrides": {
    "sharp": "$sharp",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    }
  }
}
